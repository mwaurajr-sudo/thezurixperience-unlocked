# Express Port
PORT=5000
NODE_ENV=development

# Supabase Credentials (Critical: Use SERVICE_ROLE_KEY to bypass RLS for uploads/inserts)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-bypasses-rls

# Both senders appear to guests under the name "Zuri". *_FROM only sets the address.
# Gmail always sends from the signed-in account unless the address is one of its verified aliases.

# RSVP sender: sends the "confirm your attendance" email
# With Gmail, EMAIL_PASSWORD must be an app password. Set EMAIL_HOST and EMAIL_PORT instead of
# EMAIL_SERVICE for a non-Gmail mailbox.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
REPLY_TO=zurixperience@gmail.com

# Ticket sender: a different account that sends the ticket once attendance is confirmed
# Required. It does not fall back to the RSVP sender.
TICKET_EMAIL_SERVICE=gmail
TICKET_EMAIL_USER=your-ticket-email@gmail.com
TICKET_EMAIL_PASSWORD=your-ticket-gmail-app-password
TICKET_EMAIL_FROM=your-ticket-email@gmail.com

# Optional: Resend API, used when SMTP is unavailable or fails (some hosts block SMTP).
# Resend only delivers from a verified domain, so EMAIL_FROM and TICKET_EMAIL_FROM must use it.
# RESEND_API_KEY=re_your_resend_api_key

# Public site address, used to build the confirmation link in the RSVP email
PUBLIC_SITE_URL=http://localhost:8080

# Frontend Client URL (For CORS setting)
FRONTEND_URL=http://localhost:5173
