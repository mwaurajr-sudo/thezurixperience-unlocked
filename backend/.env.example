# Express Port
PORT=5000
NODE_ENV=development

# Supabase Credentials (Critical: Use SERVICE_ROLE_KEY to bypass RLS for uploads/inserts)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-bypasses-rls

# All emails appear to guests under the name "Zuri". *_FROM only sets the address.
# Gmail always sends from the signed-in account unless the address is one of its verified aliases.

# Main sender: automatic RSVP confirmation and ticket emails
# With Gmail, EMAIL_PASSWORD must be an app password. Set EMAIL_HOST and EMAIL_PORT instead of
# EMAIL_SERVICE for a non-Gmail mailbox.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
REPLY_TO=zurixperience@gmail.com

# Invite sender: a different account that sends event invites from the admin screen
# Required for invites. It does not fall back to the main sender.
INVITE_EMAIL_SERVICE=gmail
INVITE_EMAIL_USER=your-invite-email@gmail.com
INVITE_EMAIL_PASSWORD=your-invite-gmail-app-password
INVITE_EMAIL_FROM=your-invite-email@gmail.com

# Optional: Resend API, used when SMTP is unavailable or fails (some hosts block SMTP).
# Resend only delivers from a verified domain, so EMAIL_FROM and INVITE_EMAIL_FROM must use it.
# RESEND_API_KEY=re_your_resend_api_key

# Public site address, used to build the links in invite and RSVP emails
PUBLIC_SITE_URL=https://thezurixperience.onrender.com

# Frontend Client URL (For CORS setting)
FRONTEND_URL=http://localhost:5173
